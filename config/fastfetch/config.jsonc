{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/alan/.config/fastfetch/arch-linux.png",
    "width": 40,
    "height": 16,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2,
    }
  },
  "display": {
    "separator": ":",
    "key": {
      "width": 12
    },
    "color": {
      "keys": "cyan",
      "title": "cyan"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS",
      "format": "Arch Linux"
    },
    {
      "type": "host",
      "key": "Host",
      "format": "ASUS Vivobook S16"
    },
    {
      "type": "packages",
      "key": "Packages",
      "format": "{pacman} pacman, {flatpak-all} flatpak"
    },
    "break",
    {
      "type": "wm",
      "key": "WM",
      "format": "{pretty-name}"
    },
    {
      "type": "display",
      "key": "Display",
      "format": "3200x2000, 120Hz"
    },
    {
      "type": "theme",
      "key": "Theme",
      "format": "Сatppuccin Mocha Blue"
    },
    {
      "type": "icons",
      "key": "Icons",
      "format": "Dracula"
    },
    {
      "type": "font",
      "key": "Font",
      "format": "JetBrainsMono Nerd Font 12pt, Medium"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "Shell",
      "format": "{pretty-name}"
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU",
      "format": "AMD Ryzen 7 8845HS (16) 5.14 GHz"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Disk",
      "folders": "/:/data",
      "format": "{1} / {2} ({3})"
    },
  ]
}