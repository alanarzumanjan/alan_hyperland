#!/usr/bin/env bash
STEP=5

get_backlight() {
    brightnessctl -m | awk -F, '{gsub("%","",$4); print $4}'
}

inc_backlight() {
    brightnessctl set "${STEP}%+"
}

dec_backlight() {
    brightnessctl set "${STEP}%-"
}

case "$1" in
    --get)  get_backlight ;;
    --up)   inc_backlight ;;
    --down) dec_backlight ;;
    *)      get_backlight ;;
esac